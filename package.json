{
  "name": "dashboard-security-kit",
  "version": "1.0.1",
  "description": "Shared security baseline for client dashboards on Cloudflare Workers: Access sign-in + MFA, CSRF, headers, rate limits, config checks, audits.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./vite": {
      "types": "./vite/index.d.ts",
      "default": "./vite/index.js"
    }
  },
  "bin": {
    "dashboard-security-kit": "bin/cli.mjs"
  },
  "files": [
    "src",
    "bin",
    "eslint",
    "vite",
    "BASELINE.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm test",
    "hooks": "git config core.hooksPath .githooks"
  },
  "peerDependencies": {
    "hono": "^4.13.0",
    "jose": "^6.2.0",
    "zod": "^4.6.0",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
